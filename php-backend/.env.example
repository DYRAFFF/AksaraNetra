# AksaraNetra PHP/Laravel Backend Environment Configuration

# Application settings
APP_NAME=AksaraNetra
# Set APP_ENV to "production" in Docker / production deployments, or "development" locally
APP_ENV=development
# Set APP_DEBUG to false in production to prevent stack trace leaks
APP_DEBUG=true
# Optional 32-byte AES key (base64:...). If omitted, automatically derived from BACKEND_SECRET
# APP_KEY=

# Server binding (0.0.0.0 in Docker, 127.0.0.1 for local dev)
PORT=8787
HOST=127.0.0.1

# Allowed origins for CORS (comma-separated, without trailing slashes).
# Requests without an Origin header (curl, mobile, server-to-server) are always allowed.
# Requests with an Origin header not listed here receive HTTP 403 "origin-not-allowed".
FRONTEND_ORIGINS=http://localhost:3000

# Cryptographic HMAC secret for signing job access tokens and share tokens.
# CRITICAL: MUST be at least 32 characters long in production!
BACKEND_SECRET=aksaranetra-development-secret-change-me-32chars

# Storage directory for SQLite jobs database (jobs.sqlite) and audit artifacts.
# In Docker, this MUST be set to /data (the persistent volume mount point).
# In local development, use ./data.
BACKEND_DATA_DIR=./data

# Reverse proxy client IP handling:
# Set to 1 if deployed behind a reverse proxy/load balancer (e.g. Render, Cloudflare, Nginx)
# to trust the first IP in the X-Forwarded-For header for rate limiting.
# Set to 0 if clients connect directly.
TRUST_PROXY=0

# Audit job execution timeout in milliseconds (default: 180000 = 3 minutes).
# Jobs running longer than this are aborted with error code "audit-timeout".
AUDIT_TIMEOUT_MS=180000

# Retention period in milliseconds for completed audit results and artifacts (default: 604800000 = 7 days).
# Expired jobs and their artifact folders are automatically purged by audit:cleanup.
RESULT_RETENTION_MS=604800000

# Per-IP rate limit: maximum number of audit jobs allowed per 1-hour sliding window (default: 10).
AUDIT_RATE_LIMIT=10

# Maximum allowed JSON request body size in bytes (default: 8192 = 8 KB).
# Requests exceeding this size are rejected with HTTP 413 "payload-too-large".
MAX_BODY_BYTES=8192

# Worker periodic cleanup interval in milliseconds (default: 3600000 = 1 hour).
CLEANUP_INTERVAL_MS=3600000

# Chromium resource mode:
# Set to 1 in Docker containers or memory-constrained environments (e.g. 512MB RAM)
# to enable aggressive Chromium memory optimization flags and screenshot size limits.
# Set to 0 for full resources.
CHROMIUM_LOW_RESOURCE_MODE=0
