{
    "name": "aksaranetra/backend",
    "type": "project",
    "description": "AksaraNetra Backend in PHP/Laravel",
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": "^11.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "test": "@php vendor/bin/phpunit",
        "test:usecases": "@php vendor/bin/phpunit --testsuite=UseCases",
        "test:security": "@php vendor/bin/phpunit tests/Feature/UseCases/SecurityScenarioTest.php",
        "test:coverage": "@php -d zend_extension=php_xdebug.dll -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
